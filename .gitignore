# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/

# Node (no dependencies today, but keep it out if any are added)
node_modules/
npm-debug.log*

# Secrets. The Resend key lives here and must never be committed —
# .env.example carries the shape, with the values left blank.
.env
.env.*
!.env.example

# The generated pages ARE committed on purpose — they are the deployable
# artifact. Each one is <slug>/index.html so its URL carries no extension on
# any static host, with index.html at the root. Regenerate: node build/build.js
