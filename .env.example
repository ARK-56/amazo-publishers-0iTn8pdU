# Copy to .env for local work, and set the same three values in your host's
# environment settings (Vercel: Project → Settings → Environment Variables;
# Netlify: Site configuration → Environment variables).
#
# .env is gitignored. Never commit a real key, and never put one in
# build/site.data.js or anywhere under assets/ — everything there is served
# to the browser.
#
# Until all three are set the endpoint answers 503 and the forms quietly fall
# back to opening the visitor's mail client, so the site keeps working.

# From https://resend.com/api-keys — starts with "re_".
RESEND_API_KEY=

# Where enquiries land. Comma-separated for more than one.
ENQUIRY_TO=

# The From address. Resend only accepts a domain you have verified with them,
# so this cannot be a gmail.com address — verify the sending domain first at
# https://resend.com/domains. A display name is allowed:
#   Amazo Publishers <enquiries@amazopublishers.com>
ENQUIRY_FROM=
